<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hubris.Desktop.App"
             RequestedThemeVariant="Dark">

    <!-- Linear-style dark surfaces: Fluent keeps its templates, the palette is swapped underneath. -->
    <Application.Resources>
        <Color x:Key="SystemAccentColor">#7170FF</Color>
        <Color x:Key="SystemAccentColorLight1">#8584FF</Color>
        <Color x:Key="SystemAccentColorDark1">#5E5DE0</Color>

        <!-- text controls -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#0B0C0D" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0B0C0E" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0B0C0E" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#232427" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#313236" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7170FF" />
        <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
        <SolidColorBrush x:Key="TextControlForeground" Color="#F7F8F8" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F7F8F8" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F7F8F8" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7B8089" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#7B8089" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#7B8089" />
        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#557170FF" />

        <!-- buttons -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#131415" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1C1D1F" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#232427" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0F1011" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#232427" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#313236" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#313236" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#1C1D1F" />
        <SolidColorBrush x:Key="ButtonForeground" Color="#F7F8F8" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F7F8F8" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F7F8F8" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#7B8089" />
        <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>

        <!-- tabs -->
        <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#8A8F98" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#C9CCD3" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#F7F8F8" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#F7F8F8" />
        <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#F7F8F8" />
        <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
        <x:Double x:Key="TabItemMinHeight">34</x:Double>
        <x:Double x:Key="TabItemPipeThickness">2</x:Double>

        <!-- lists -->
        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#101112" />
        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#141516" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#141516" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#18191B" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#1C1D1F" />

        <!-- check boxes -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#2B2F38" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#0B0C0E" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#7170FF" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#7170FF" />

        <!-- scroll bars -->
        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#232427" />
        <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#323640" />
        <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#3A3F4A" />
        <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#232427" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Hubris.Desktop/Views/Styles.axaml" />
    </Application.Styles>
</Application>
