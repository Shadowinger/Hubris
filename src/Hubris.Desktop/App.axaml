<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hubris.Desktop.App"
             RequestedThemeVariant="Dark">

    <!-- Linear-style dark surfaces: Fluent keeps its templates, the palette is swapped underneath. -->
    <Application.Resources>
        <Color x:Key="SystemAccentColor">#5E6AD2</Color>
        <Color x:Key="SystemAccentColorLight1">#6E7AE0</Color>
        <Color x:Key="SystemAccentColorDark1">#4F5ABF</Color>

        <!-- text controls -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#0B0C0E" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0B0C0E" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0B0C0E" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#22252C" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2B2F38" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5E6AD2" />
        <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
        <SolidColorBrush x:Key="TextControlForeground" Color="#F2F3F5" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F2F3F5" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F2F3F5" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#575C66" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#575C66" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#575C66" />
        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#405E6AD2" />

        <!-- buttons -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#16181D" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E2028" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#23262E" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#101114" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#262930" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#323640" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#323640" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#1C1E24" />
        <SolidColorBrush x:Key="ButtonForeground" Color="#E2E4E9" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F2F3F5" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F2F3F5" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#575C66" />
        <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>

        <!-- tabs -->
        <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#8A8F98" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#C9CCD3" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#F2F3F5" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#F2F3F5" />
        <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#5E6AD2" />
        <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
        <x:Double x:Key="TabItemMinHeight">34</x:Double>
        <x:Double x:Key="TabItemPipeThickness">2</x:Double>

        <!-- lists -->
        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#121417" />
        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#16181D" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#16181D" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#1A1C22" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#1E2028" />

        <!-- check boxes -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#2B2F38" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#0B0C0E" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#5E6AD2" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#5E6AD2" />

        <!-- scroll bars -->
        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#262930" />
        <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#323640" />
        <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#3A3F4A" />
        <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#262930" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Hubris.Desktop/Views/Styles.axaml" />
    </Application.Styles>
</Application>
