<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hubris.Desktop.ViewModels"
        x:Class="Hubris.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Hubris"
        Icon="/Assets/hubris.png"
        Width="1320" Height="820" MinWidth="1160" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="232,*">

        <!-- ============================================================ sidebar -->
        <Border Grid.Column="0" Background="#08090A" BorderBrush="#1C1D1F" BorderThickness="0,0,1,0" Padding="10,14,10,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,8,14" Spacing="8">
                    <!-- the sheared-disc mark, same geometry as brand/hubris-mark.svg -->
                    <Path Fill="#F7F8F8" Width="12" Height="14" Stretch="Uniform" VerticalAlignment="Center" Data="M498 300 A262 262 0 0 0 498 824 Z M526 200 A262 262 0 0 1 526 724 Z" />
                    <TextBlock Text="Hubris" FontSize="14" FontWeight="SemiBold" LetterSpacing="-0.2" VerticalAlignment="Center" />
                </StackPanel>

                <Button DockPanel.Dock="Top" Classes="ghost" Classes.on="{Binding ShowConfig}" Command="{Binding ShowConfigCommand}"
                        HorizontalAlignment="Stretch" Padding="8,6" AutomationProperties.Name="Configuration">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Classes="icon" Data="M2.5,4.5 H13.5 M2.5,8 H13.5 M2.5,11.5 H9.5" />
                        <TextBlock Text="Configuration" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Top" Classes="ghost" Classes.on="{Binding ShowCatalog}" Command="{Binding ShowCatalogCommand}"
                        HorizontalAlignment="Stretch" Padding="8,6" Margin="0,2,0,0" AutomationProperties.Name="Known servers">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Classes="icon" Data="M8,2.5 A5.5,5.5 0 1 0 8,13.5 A5.5,5.5 0 1 0 8,2.5 M2.5,8 H13.5 M8,2.5 C10,4.5 10,11.5 8,13.5 M8,2.5 C6,4.5 6,11.5 8,13.5" />
                        <TextBlock Text="Known servers" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <DockPanel DockPanel.Dock="Top" Margin="8,18,2,6">
                    <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding RescanCommand}" Padding="6,1" MinHeight="20" FontSize="11" Content="Rescan" ToolTip.Tip="Rescan the runtime directory" />
                    <TextBlock Classes="section" VerticalAlignment="Center" Text="Running hubs" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,10,6,0" Spacing="2">
                    <TextBlock Classes="section" Text="Runtime dir" />
                    <TextBlock Classes="mono muted" FontSize="10" TextWrapping="Wrap" Text="{Binding RuntimeDir}" />
                </StackPanel>

                <TextBlock IsVisible="{Binding NoHubs}" Classes="secondary" Margin="6,4" FontSize="12" TextWrapping="Wrap"
                           Text="No hub is running. Start one from Claude Desktop, Claude Code or VS Code, or launch a test instance from the configurator." />

                <ListBox ItemsSource="{Binding Hubs}" SelectedItem="{Binding SelectedHub}" IsVisible="{Binding HasHubs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HubViewModel">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono muted" FontSize="11" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Classes="pill indigo" IsVisible="{Binding HasApprovals}"><TextBlock Classes="num" Text="{Binding PendingCount}" /></Border>
                                    <Border Classes="pill warn" IsVisible="{Binding IsOutdated}" ToolTip.Tip="{Binding OutdatedHint}"><TextBlock Text="old build" /></Border>
                                    <Border Classes="pill" Classes.ok="{Binding IsSafe}" Classes.indigo="{Binding IsAuto}" Classes.warn="{Binding IsBypass}"><TextBlock Text="{Binding Mode}" /></Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ hub view -->
        <Panel Grid.Column="1" IsVisible="{Binding ShowHub}">
        <Grid DataContext="{Binding SelectedHub}" x:DataType="vm:HubViewModel" ColumnDefinitions="*,300">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="20,16,20,16">

            <!-- header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Border Classes="seg" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="seg" Classes.on="{Binding IsSafe}" Command="{Binding SetSafeCommand}" Content="Safe" ToolTip.Tip="Ask: destructive tools and dangerous arguments wait for your approval" />
                            <Button Classes="seg" Classes.on="{Binding IsAuto}" Command="{Binding SetAutoCommand}" Content="Auto" ToolTip.Tip="Run without asking; dangerous calls are blocked and the model is told why. After 3 blocks in a row or 20 in total it asks you" />
                            <Button Classes="seg" Classes.on="{Binding IsBypass}" Command="{Binding SetBypassCommand}" Content="Bypass" ToolTip.Tip="No checks; only removing a critical path still waits for you" />
                        </StackPanel>
                    </Border>
                    <Button Classes="ghost" Command="{Binding RefreshCommand}" Content="Refresh" />
                    <Button Classes="ghost" Command="{Binding ClearCacheCommand}" Content="Clear cache" ToolTip.Tip="Drop cached tool lists, start every bridge and list its tools again" />
                    <Button Classes="ghost" Command="{Binding ShutdownCommand}" Content="Stop hub" />
                </StackPanel>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border Classes="pill" Classes.ok="{Binding IsSafe}" Classes.indigo="{Binding IsAuto}" Classes.warn="{Binding IsBypass}"><TextBlock Text="{Binding Mode}" /></Border>
                        <Border Classes="pill" IsVisible="{Binding IsCompact}"><TextBlock Text="compact" /></Border>
                    </StackPanel>
                    <TextBlock Classes="mono muted" FontSize="11" Text="{Binding Cwd}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- approval gate -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Approvals}" IsVisible="{Binding HasApprovals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApprovalViewModel">
                        <Border Classes="approval">
                            <StackPanel>
                                <DockPanel Margin="12,9">
                                    <TextBlock DockPanel.Dock="Right" Classes="secondary num" FontSize="12" Text="{Binding Remaining}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="7" Height="7" Fill="#E2B34A" VerticalAlignment="Center" />
                                        <TextBlock Classes="title" Text="Waiting for you" VerticalAlignment="Center" />
                                        <TextBlock Classes="mono muted num" FontSize="11" Text="{Binding RequestedAt}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Height="1" Background="#29E2B34A" />
                                <StackPanel Margin="12,11,12,0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="mono strong" FontSize="13" Text="{Binding Tool}" VerticalAlignment="Center" />
                                        <Border Classes="pill" Classes.warn="{Binding IsMutating}" Classes.danger="{Binding IsDestructive}" Classes.ok="{Binding IsReadOnly}"><TextBlock Text="{Binding Risk}" /></Border>
                                    </StackPanel>
                                    <TextBlock Classes="secondary" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" />
                                    <Border Classes="code">
                                        <ScrollViewer MaxHeight="130" HorizontalScrollBarVisibility="Auto">
                                            <TextBlock Classes="mono" Text="{Binding ArgsJson}" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                                <DockPanel Margin="12,8,12,11">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="deny" Command="{Binding DenyCommand}" Content="Deny" />
                                        <Button Classes="approve" Command="{Binding ApproveCommand}" Content="Approve" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding Remember}" Content="Remember for this session" ToolTip.Tip="Apply this choice to every later call of this tool until the hub restarts" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TabControl Grid.Row="2">
                <!-- dashboard -->
                <TabItem Header="Dashboard">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,12,0,0">

                        <!-- what the gate has done, and what the model is carrying -->
                        <Border Grid.Row="0" Classes="card" Padding="0" ClipToBounds="True">
                            <Grid ColumnDefinitions="*,*,*,*,2.1*">
                                <Border Grid.Column="0" Classes="cell"><StackPanel Spacing="2"><TextBlock Classes="section" Text="Calls" /><TextBlock Classes="metric" Text="{Binding Calls}" /></StackPanel></Border>
                                <Border Grid.Column="1" Classes="cell"><StackPanel Spacing="2"><TextBlock Classes="section" Text="Blocked" /><TextBlock Classes="metric" Text="{Binding Blocked}" /></StackPanel></Border>
                                <Border Grid.Column="2" Classes="cell"><StackPanel Spacing="2"><TextBlock Classes="section" Text="DLP redactions" /><TextBlock Classes="metric" Text="{Binding Dlp}" /></StackPanel></Border>
                                <Border Grid.Column="3" Classes="cell">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="section" Text="Bridges running" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Classes="metric" Text="{Binding BridgesRunning}" />
                                            <TextBlock Classes="secondary num" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,3" Text="{Binding BridgesOf}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Classes="cell last">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="section" Text="Context" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Classes="metric" Text="{Binding ActiveTools}" />
                                            <TextBlock Classes="secondary num" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,3" Text="{Binding ContextOf}" />
                                        </StackPanel>
                                        <ProgressBar Classes="meter" Minimum="0" Maximum="100" Value="{Binding ContextPercent}" Margin="0,5,0,4" />
                                        <TextBlock Classes="secondary num" FontSize="12" Text="{Binding ContextNote}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- the process itself, kept to one quiet line -->
                        <TextBlock Grid.Row="1" Classes="mono muted num" FontSize="11" Margin="2,8,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="uptime " /><Run Text="{Binding Uptime}" /><Run Text="  ·  rss " /><Run Text="{Binding Rss}" /><Run Text="  ·  heap " /><Run Text="{Binding Heap}" /><Run Text="  ·  cache " /><Run Text="{Binding Cache}" /><Run Text="  ·  " /><Run Text="{Binding ToolCount}" /><Run Text=" tools  ·  " /><Run Text="{Binding Clients}" /><Run Text=" window(s) attached" />
                        </TextBlock>

                        <!-- connections: bridges with an OAuth block, one aligned row each -->
                        <StackPanel Grid.Row="2" IsVisible="{Binding HasAuth}">
                            <TextBlock Classes="section" Margin="2,16,0,6" Text="Connections" />
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <ItemsControl Classes="rows" ItemsSource="{Binding Auth}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AuthRow">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="8,150,*,Auto,Auto" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Classes="out" Classes.ok="{Binding IsConnected}" Classes.warn="{Binding IsPending}" Classes.danger="{Binding IsBroken}"><Ellipse /></StackPanel>
                                                    <TextBlock Grid.Column="1" Classes="strong" FontWeight="Medium" VerticalAlignment="Center" Text="{Binding Bridge}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Classes="secondary" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding State}" /><Run Text="  " /><Run Text="{Binding Detail}" />
                                                    </TextBlock>
                                                    <Button Grid.Column="3" Command="{Binding ConnectCommand}" Content="{Binding ConnectLabel}" IsEnabled="{Binding CanConnect}" MinWidth="92" HorizontalContentAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Opens the browser to sign in; the token is kept in the OS secret store" />
                                                    <Panel Grid.Column="4" MinWidth="88" VerticalAlignment="Center">
                                                        <Button Classes="ghost" Command="{Binding RevokeCommand}" Content="Disconnect" IsVisible="{Binding HasToken}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Forget the stored token" />
                                                    </Panel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- live calls: one table, newest first -->
                        <Border Grid.Row="3" Classes="card" Padding="0" ClipToBounds="True" Margin="0,16,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="#1C1D1F" BorderThickness="0,0,0,1" Padding="12,6,6,6">
                                    <Grid ColumnDefinitions="*,92,170,60,64" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" FontSize="12" FontWeight="Medium" Foreground="#D0D6E0" VerticalAlignment="Center" Text="Live calls" />
                                        <TextBlock Grid.Column="1" Classes="section" FontWeight="Normal" VerticalAlignment="Center" Text="risk" />
                                        <TextBlock Grid.Column="2" Classes="section" FontWeight="Normal" VerticalAlignment="Center" Text="outcome" />
                                        <TextBlock Grid.Column="3" Classes="section" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" Text="took" />
                                        <Button Grid.Column="4" Classes="ghost" Command="{Binding ClearEventsCommand}" Padding="8,1" MinHeight="22" FontSize="11" HorizontalAlignment="Right" Content="Clear" />
                                    </Grid>
                                </Border>
                                <Panel>
                                    <TextBlock IsVisible="{Binding !Events.Count}" Classes="muted" FontSize="12" Margin="12,10"
                                               Text="Calls appear here as the model makes them." />
                                    <ListBox Classes="events" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EventRow">
                                                <Grid ColumnDefinitions="*,92,170,60,58" ColumnSpacing="12">
                                                    <TextBlock Grid.Column="0" Classes="mono" Foreground="#D0D6E0" Text="{Binding Tool}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Classes="risk" Classes.m="{Binding RiskMutating}" Classes.d="{Binding RiskDestructive}" Text="{Binding RiskText}" />
                                                    <StackPanel Grid.Column="2" Classes="out" Classes.ok="{Binding ToneOk}" Classes.warn="{Binding ToneWarn}" Classes.danger="{Binding ToneDanger}" Classes.indigo="{Binding ToneIndigo}">
                                                        <Ellipse /><TextBlock Text="{Binding Outcome}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Classes="secondary num" FontSize="12" Text="{Binding Duration}" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Classes="mono muted num" FontSize="11" Text="{Binding Time}" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Panel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- tools -->
                <TabItem Header="Tools">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">
                        <Border Grid.Row="0" Classes="card" Padding="12,8" Margin="0,0,0,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Classes="pill" Classes.ok="{Binding SavedGood}" Classes.warn="{Binding SavedSome}"><TextBlock Classes="num" Text="{Binding SavedText}" /></Border>
                                <TextBlock Classes="mono secondary num" VerticalAlignment="Center" Text="{Binding ContextMeter}" />
                            </DockPanel>
                        </Border>
                        <TextBox Grid.Row="1" Text="{Binding ToolFilter}" PlaceholderText="Search tools by name or description; groups open when something matches" Margin="0,0,0,8" />
                        <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding ToolGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolGroup">
                                            <StackPanel>
                                                <Button Classes="grouphead" Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Classes="mono muted num" FontSize="11" VerticalAlignment="Center" Text="{Binding Summary}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="muted" Width="12" VerticalAlignment="Center" Text="{Binding Chevron}" />
                                                            <TextBlock Classes="strong" FontWeight="Medium" VerticalAlignment="Center" Text="{Binding Name}" />
                                                            <Border Classes="pill" VerticalAlignment="Center"><TextBlock Classes="num" Text="{Binding CountText}" /></Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                <ItemsControl Classes="rows" IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Tools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolRow">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="mono strong" FontWeight="Medium" Text="{Binding Name}" VerticalAlignment="Center" />
                                                            <Border Classes="pill" IsVisible="{Binding IsBridged}"><TextBlock Text="{Binding Bridge}" /></Border>
                                                            <Border Classes="pill" IsVisible="{Binding HasDecision}" Classes.ok="{Binding DecisionAlways}" Classes.danger="{Binding DecisionNever}" ToolTip.Tip="Remembered Safe-mode decision for this session"><TextBlock Text="{Binding Decision}" /></Border>
                                                        </StackPanel>
                                                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Classes="mono muted num" Text="{Binding TokensText}" MinWidth="60" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Classes="pill" MinWidth="78" Classes.ok="{Binding IsReadOnly}" Classes.warn="{Binding IsMutating}" Classes.danger="{Binding IsDestructive}">
                                                        <TextBlock Text="{Binding Risk}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="3" Classes="pill" MinWidth="76" Classes.indigo="{Binding StateIndigo}">
                                                        <TextBlock Text="{Binding VisibilityText}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <Panel Grid.Column="4" VerticalAlignment="Center" MinWidth="64">
                                                        <Button Command="{Binding RevealCommand}" Content="Unlock" IsVisible="{Binding CanUnlock}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                                        <Button Command="{Binding LockCommand}" Content="Lock" IsVisible="{Binding CanLock}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Hide this tool from tools/list again to free context" />
                                                    </Panel>
                                                    <Button Grid.Column="5" Classes="ghost" Command="{Binding ForgetCommand}" Content="Forget" IsVisible="{Binding HasDecision}" VerticalAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Drop the remembered decision; this tool will be held for approval again" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- the selected call: what was sent, what came back -->
        <Border Grid.Column="1" Background="#08090A" BorderBrush="#1C1D1F" BorderThickness="1,0,0,0" Padding="14,18,14,16">
            <ScrollViewer>
                <StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding SelectedEvent, Converter={x:Static ObjectConverters.IsNull}}">
                        <TextBlock Classes="section" Text="Selected call" />
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Select a call to see what was sent and what came back." />
                    </StackPanel>
                    <StackPanel DataContext="{Binding SelectedEvent}" x:DataType="vm:EventRow"
                                IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Classes="out" Classes.ok="{Binding ToneOk}" Classes.warn="{Binding ToneWarn}" Classes.danger="{Binding ToneDanger}" Classes.indigo="{Binding ToneIndigo}" Margin="8,0,0,0">
                                <Ellipse /><TextBlock Text="{Binding Outcome}" />
                            </StackPanel>
                            <TextBlock Classes="mono strong" Text="{Binding Tool}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Classes="hair" />
                        <TextBlock Classes="section" Margin="0,14,0,6" Text="Request" IsVisible="{Binding HasArgs}" />
                        <Border Classes="code" IsVisible="{Binding HasArgs}">
                            <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" Text="{Binding Args}" />
                        </Border>
                        <TextBlock Classes="section" Margin="0,14,0,6" Text="{Binding ResultLabel}" IsVisible="{Binding HasPreview}" />
                        <Border Classes="code" Classes.stop="{Binding ToneDanger}" IsVisible="{Binding HasPreview}">
                            <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" Text="{Binding Preview}" />
                        </Border>
                        <TextBlock Classes="mono muted num" FontSize="11" Margin="0,12,0,0" Text="{Binding Meta}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>
        </Panel>

        <!-- ============================================================ known servers -->
        <Panel Grid.Column="1" IsVisible="{Binding ShowCatalog}">
        <Grid DataContext="{Binding Config}" x:DataType="vm:ConfigViewModel" RowDefinitions="Auto,Auto,*,Auto" Margin="20,14,20,16">
            <StackPanel Grid.Row="0" Spacing="3">
                <TextBlock Classes="h1" Text="Known servers" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Remote MCP servers from the Claude connector directory, or anything in the public MCP registry. Add writes the bridge to config.json; sign in with Connect on the hub dashboard." />
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="0,14,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <TextBox Width="260" Text="{Binding CatalogQuery}" PlaceholderText="search the public MCP registry" />
                    <Button Command="{Binding SearchCatalogCommand}" Content="Search" />
                    <Button Classes="ghost" Command="{Binding ResetCatalogCommand}" Content="Directory" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" Text="{Binding CatalogNote}" />
            </DockPanel>
            <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
                <ScrollViewer>
                    <ItemsControl Classes="rows" ItemsSource="{Binding Catalog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CatalogRow">
                                <Border Classes="row">
                                    <Grid ColumnDefinitions="200,Auto,*,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="strong" FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="mono muted" FontSize="11" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center"><TextBlock Text="{Binding Category}" /></Border>
                                        <TextBlock Grid.Column="2" Classes="secondary" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Description}" />
                                        <Button Grid.Column="3" Command="{Binding AddCommand}" Content="{Binding AddLabel}" IsEnabled="{Binding CanAdd}" MinWidth="72" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock Grid.Row="3" Classes="secondary" FontSize="12" Margin="0,8,0,0" Text="{Binding LastResult}" TextWrapping="Wrap" />
        </Grid>
        </Panel>

        <!-- ============================================================ configurator -->
        <Panel Grid.Column="1" IsVisible="{Binding ShowConfig}">
        <ScrollViewer DataContext="{Binding Config}" x:DataType="vm:ConfigViewModel" Padding="20,14,20,16">
            <StackPanel Spacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h1" Text="Configuration" />
                    <TextBlock Classes="secondary" FontSize="12" Text="Build the server command line, register it in your MCP clients, or start a local test instance." />
                </StackPanel>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="title" Text="Server binary" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseServerCommand}" Content="Browse" Margin="8,0,0,0" />
                            <TextBox Classes="mono" Text="{Binding ServerPath}" PlaceholderText="/path/to/Hubris" />
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="#F87171" IsVisible="{Binding !ServerPathValid}" Text="Not found. Point this at the published Hubris executable." />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="title" Text="Policy" />
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <Border Classes="seg">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="seg" Classes.on="{Binding IsSafe}" Command="{Binding SetSafeCommand}" Content="Safe" ToolTip.Tip="Ask: destructive tools and dangerous arguments wait for your approval" />
<Button Classes="seg" Classes.on="{Binding IsAuto}" Command="{Binding SetAutoCommand}" Content="Auto" ToolTip.Tip="Run without asking; dangerous calls are blocked and the model is told why. After 3 blocks in a row or 20 in total it asks you" />
                                    <Button Classes="seg" Classes.on="{Binding IsBypass}" Command="{Binding SetBypassCommand}" Content="Bypass" />
                                </StackPanel>
                            </Border>
                            <CheckBox IsChecked="{Binding Compact}" Content="Compact context (hide on-demand tools until unlocked)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <CheckBox IsChecked="{Binding Verbose}" Content="Verbose stderr logging" />
                            <CheckBox IsChecked="{Binding NoControl}" Content="Disable control socket (no dashboard, no approvals)" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="Approval timeout (s)" />
                                <TextBox Classes="mono" Text="{Binding ApprovalTimeout}" Width="64" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding ScanClientsCommand}" Content="Scan" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="title" Text="Detected client configs" />
                                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="MCP servers found in Claude Desktop, Claude Code, Cursor, Windsurf and the chosen VS Code workspace. Import turns them into bridges and leaves Hubris as the client's only server (backup kept)." />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding ScanProjectsCommand}" Content="Scan projects" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding BrowseProjectRootCommand}" Content="Browse" Margin="8,0,0,0" />
                            <TextBox Classes="mono" Text="{Binding ProjectRoot}" PlaceholderText="project root to walk for .mcp.json / .cursor/mcp.json / .vscode/mcp.json (depth 4)" />
                        </DockPanel>
                        <TextBlock Classes="muted" FontSize="12" Text="No client configs found." IsVisible="{Binding NoClients}" />
                        <ItemsControl ItemsSource="{Binding Clients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetectedClientRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="strong" FontWeight="Medium" Text="{Binding Name}" VerticalAlignment="Center" />
                                                <Border Classes="pill" Classes.indigo="{Binding HasServers}"><TextBlock Classes="num" Text="{Binding ServersText}" /></Border>
                                                <Border Classes="pill ok" IsVisible="{Binding IsGateway}"><TextBlock Text="gateway" /></Border>
                                            </StackPanel>
                                            <TextBlock Classes="mono muted" FontSize="11" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="secondary" FontSize="11" Text="{Binding ServerNames}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasServers}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="ghost" Command="{Binding RestoreCommand}" Content="Restore" IsVisible="{Binding HasBackup}" />
                                        <Button Grid.Column="3" Command="{Binding ImportCommand}" Content="{Binding ActionText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                <Button Classes="ghost" Command="{Binding AddBridgeCommand}" Content="Add bridge" />
                                <Button Command="{Binding SaveBridgesCommand}" Content="Save bridges" />
                            </StackPanel>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="title" Text="Bridges" />
                                <TextBlock Classes="mono muted" FontSize="11" Text="{Binding ConfigPath}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Bridges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BridgeRow">
                                    <Grid ColumnDefinitions="130,170,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                        <TextBox Grid.Column="0" Text="{Binding Name}" PlaceholderText="name (gh)" />
                                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding Command}" PlaceholderText="command (npx) or https://host/mcp" />
                                        <TextBox Grid.Column="2" Classes="mono" Text="{Binding Args}" PlaceholderText="{Binding ArgsPlaceholder}" />
                                        <CheckBox Grid.Column="3" Content="OAuth" IsChecked="{Binding OAuth}" IsVisible="{Binding IsRemote}" VerticalAlignment="Center" ToolTip.Tip="Sign in through the browser; the token is kept in the OS secret store" />
                                        <Border Grid.Column="4" Classes="pill" IsVisible="{Binding HasSource}"><TextBlock Text="{Binding Source}" /></Border>
                                        <Border Grid.Column="5" Classes="pill warn" IsVisible="{Binding HasEnv}" ToolTip.Tip="Environment variables and HTTP headers imported from the client config are kept in config.json (mode 0600)"><TextBlock Classes="num" Text="{Binding EnvText}" /></Border>
                                        <Button Grid.Column="6" Classes="ghost" Command="{Binding RemoveCommand}" Content="Remove" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CopyCommandCommand}" Content="Copy" />
                            <TextBlock Classes="title" VerticalAlignment="Center" Text="Resulting command" />
                        </DockPanel>
                        <Border Classes="code">
                            <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding CommandPreview}" />
                        </Border>
                        <TextBlock Classes="muted" FontSize="11" Text="Bridges are read from config.json at startup, so this command is the same for every client. For Claude Code:  claude mcp add hubris -- &lt;command above&gt;" />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="card" Padding="14,12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="title" Text="Claude Desktop" />
                            <TextBlock Classes="mono muted" FontSize="11" TextWrapping="Wrap" Text="{Binding ClaudeConfigPath}" />
                            <Button Command="{Binding InstallClaudeCommand}" HorizontalAlignment="Left">
                                <TextBlock Text="Write claude_desktop_config.json" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Padding="14,12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="title" Text="VS Code workspace" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding BrowseWorkspaceCommand}" Content="Choose" Margin="8,0,0,0" />
                                <TextBox Classes="mono" Text="{Binding WorkspaceFolder}" PlaceholderText="workspace folder" />
                            </DockPanel>
                            <TextBlock Classes="mono muted" FontSize="11" TextWrapping="Wrap" Text="{Binding VsCodeConfigPath}" />
                            <Button Command="{Binding InstallVsCodeCommand}" HorizontalAlignment="Left">
                                <TextBlock Text="Write .vscode/mcp.json" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding LaunchTestCommand}" Content="Launch test instance" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="title" Text="Test instance" />
                                <TextBlock Classes="muted" FontSize="11" Text="Starts the server with these flags, keeps it alive and shows it in the sidebar so you can try approvals." />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding LastResult}" TextWrapping="Wrap" IsVisible="{Binding LastResult.Length}" />
                        <Border Classes="hair" Margin="0,2" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding ClearLogCommand}" Padding="6,1" MinHeight="20" FontSize="11" Content="Clear" />
                            <TextBlock Classes="section" VerticalAlignment="Center" Text="Launcher log" />
                        </DockPanel>
                        <Border Classes="code" MinHeight="96">
                            <ScrollViewer MaxHeight="220">
                                <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap" Text="{Binding LogText}" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Panel>
    </Grid>
</Window>
