<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hubris.Desktop.ViewModels"
        x:Class="Hubris.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Hubris"
        Icon="/Assets/hubris.png"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="232,*">

        <!-- ============================================================ sidebar -->
        <Border Grid.Column="0" Background="#0C0D0E" BorderBrush="#1B1D21" BorderThickness="0,0,1,0" Padding="10,14,10,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,6,14" Spacing="9">
                    <!-- the sheared-disc mark, same geometry as brand/hubris-mark.svg -->
                    <Path Fill="#F2F3F5" Width="18" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                          Data="M498 300 A262 262 0 0 0 498 824 Z M526 200 A262 262 0 0 1 526 724 Z" />
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Classes="h1" Text="Hubris" FontSize="14" />
                        <TextBlock Classes="muted" FontSize="11" Text="MCP gateway control" />
                    </StackPanel>
                </StackPanel>

                <Button DockPanel.Dock="Top" Classes="ghost" Classes.on="{Binding ShowConfig}" Command="{Binding ShowConfigCommand}"
                        HorizontalAlignment="Stretch" Padding="8,5" Content="Configurator &amp; launcher" />

                <DockPanel DockPanel.Dock="Top" Margin="6,16,2,6">
                    <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding RescanCommand}" Padding="6,1" MinHeight="20" FontSize="11" Content="Rescan" ToolTip.Tip="Rescan the runtime directory" />
                    <TextBlock Classes="section" VerticalAlignment="Center" Text="RUNNING HUBS" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,10,6,0" Spacing="2">
                    <TextBlock Classes="section" Text="RUNTIME DIR" />
                    <TextBlock Classes="mono muted" FontSize="10" TextWrapping="Wrap" Text="{Binding RuntimeDir}" />
                </StackPanel>

                <TextBlock IsVisible="{Binding NoHubs}" Classes="secondary" Margin="6,4" FontSize="12" TextWrapping="Wrap"
                           Text="No hub is running. Start one from Claude Desktop, Claude Code or VS Code, or launch a test instance from the configurator." />

                <ListBox ItemsSource="{Binding Hubs}" SelectedItem="{Binding SelectedHub}" IsVisible="{Binding HasHubs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HubViewModel">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono muted" FontSize="11" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Classes="pill indigo" IsVisible="{Binding HasApprovals}"><TextBlock Classes="num" Text="{Binding PendingCount}" /></Border>
                                    <Border Classes="pill" Classes.ok="{Binding IsSafe}" Classes.warn="{Binding IsBypass}"><TextBlock Text="{Binding Mode}" /></Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ hub view -->
        <Panel Grid.Column="1" IsVisible="{Binding ShowHub}">
        <Grid DataContext="{Binding SelectedHub}" x:DataType="vm:HubViewModel" RowDefinitions="Auto,Auto,*" Margin="20,14,20,16">

            <!-- header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="seg">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="seg" Classes.on="{Binding IsSafe}" Command="{Binding SetSafeCommand}" Content="Safe" />
                            <Button Classes="seg" Classes.on="{Binding IsBypass}" Command="{Binding SetBypassCommand}" Content="Bypass" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding RefreshCommand}" Content="Refresh" />
                    <Button Command="{Binding ClearCacheCommand}" Content="Clear cache" />
                    <Button Command="{Binding ShutdownCommand}" Content="Stop hub" />
                </StackPanel>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" />
                        <Border Classes="pill" Classes.ok="{Binding IsSafe}" Classes.warn="{Binding IsBypass}"><TextBlock Text="{Binding Mode}" /></Border>
                        <Border Classes="pill indigo" IsVisible="{Binding IsCompact}"><TextBlock Text="compact" /></Border>
                    </StackPanel>
                    <TextBlock Classes="mono secondary" Text="{Binding Cwd}" />
                </StackPanel>
            </DockPanel>

            <!-- approval gate -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Approvals}" IsVisible="{Binding HasApprovals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApprovalViewModel">
                        <Border Classes="approval">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="title" Foreground="#A8AFFF" Text="Approval required" VerticalAlignment="Center" />
                                    <TextBlock Classes="mono strong" Text="{Binding Tool}" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Border Classes="pill" Classes.warn="{Binding IsMutating}" Classes.danger="{Binding IsDestructive}" Classes.ok="{Binding IsReadOnly}"><TextBlock Text="{Binding Risk}" /></Border>
                                    <TextBlock Classes="mono muted num" Text="{Binding RequestedAt}" VerticalAlignment="Center" />
                                    <TextBlock Classes="mono muted num" Text="{Binding Remaining}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="secondary" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                <Border Grid.Row="2" Grid.Column="0" Classes="code">
                                    <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Classes="mono" Text="{Binding ArgsJson}" />
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="approve" Command="{Binding ApproveCommand}" Content="Approve" HorizontalContentAlignment="Center" />
                                    <Button Classes="deny" Command="{Binding DenyCommand}" Content="Deny" HorizontalContentAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Remember}" Content="Remember for this session" FontSize="11" ToolTip.Tip="Apply this choice to every later call of this tool until the hub restarts" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TabControl Grid.Row="2">
                <!-- dashboard -->
                <TabItem Header="Dashboard">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">

                        <!-- telemetry strip: 2 x 5 property grid, hairlines between cells -->
                        <Border Grid.Row="0" Classes="card" Padding="0">
                            <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto">
                                <Border Grid.Row="0" Grid.Column="0" Classes="cell top"><StackPanel Spacing="3"><TextBlock Classes="section" Text="UPTIME" /><TextBlock Classes="metric" Text="{Binding Uptime}" /></StackPanel></Border>
                                <Border Grid.Row="0" Grid.Column="1" Classes="cell top"><StackPanel Spacing="3"><TextBlock Classes="section" Text="RSS" /><TextBlock Classes="metric" Text="{Binding Rss}" /></StackPanel></Border>
                                <Border Grid.Row="0" Grid.Column="2" Classes="cell top"><StackPanel Spacing="3"><TextBlock Classes="section" Text="HEAP" /><TextBlock Classes="metric" Text="{Binding Heap}" /></StackPanel></Border>
                                <Border Grid.Row="0" Grid.Column="3" Classes="cell top"><StackPanel Spacing="3"><TextBlock Classes="section" Text="CACHE" /><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="metric" Text="{Binding Cache}" /><TextBlock Classes="muted num" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,2" Text="{Binding CacheFill}" /></StackPanel></StackPanel></Border>
                                <Border Grid.Row="0" Grid.Column="4" Classes="cell top last"><StackPanel Spacing="3"><TextBlock Classes="section" Text="BLOCKED" /><TextBlock Classes="metric" Text="{Binding Blocked}" Foreground="#F87171" /></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="0" Classes="cell"><StackPanel Spacing="3"><TextBlock Classes="section" Text="DLP REDACTIONS" /><TextBlock Classes="metric" Text="{Binding Dlp}" /></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="1" Classes="cell"><StackPanel Spacing="3"><TextBlock Classes="section" Text="TOOLS" /><TextBlock Classes="metric" Text="{Binding ToolCount}" /></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="2" Classes="cell"><StackPanel Spacing="3"><TextBlock Classes="section" Text="BRIDGES" /><TextBlock Classes="metric" Text="{Binding BridgeCount}" /></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="3" Classes="cell"><StackPanel Spacing="3"><TextBlock Classes="section" Text="UI CLIENTS" /><TextBlock Classes="metric" Text="{Binding Clients}" /></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="4" Classes="cell last">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="section" Text="CONTEXT COST" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="metric" Text="{Binding ContextTile}" />
                                            <Border Classes="pill" Classes.ok="{Binding SavedGood}" Classes.warn="{Binding SavedSome}"><TextBlock Classes="num" Text="{Binding SavedText}" /></Border>
                                        </StackPanel>
                                        <TextBlock Classes="muted num" FontSize="11" Text="{Binding ContextTileSub}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <DockPanel Grid.Row="1" Margin="0,16,0,6">
                            <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding ClearEventsCommand}" Padding="6,1" MinHeight="20" FontSize="11" Content="Clear" />
                            <TextBlock Classes="title" VerticalAlignment="Center" Text="Live calls" />
                        </DockPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="*,10,320">
                            <Border Grid.Column="0" Classes="card" Padding="0" ClipToBounds="True">
                                <Panel>
                                    <TextBlock IsVisible="{Binding !Events.Count}" Classes="muted" FontSize="12" Margin="12,10"
                                               Text="Calls appear here as the model makes them." />
                                    <ListBox Classes="events" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EventRow">
                                                <Grid ColumnDefinitions="60,112,*,Auto,56" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Classes="mono muted num" Text="{Binding Time}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="pill" HorizontalAlignment="Left" MinWidth="72"
                                                            Classes.ok="{Binding ToneOk}" Classes.warn="{Binding ToneWarn}" Classes.danger="{Binding ToneDanger}" Classes.indigo="{Binding ToneIndigo}">
                                                        <TextBlock Text="{Binding Outcome}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Classes="mono strong" Text="{Binding Tool}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Classes="muted" FontSize="11" Text="{Binding Risk}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Classes="mono muted num" Text="{Binding Duration}" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Panel>
                            </Border>
                            <Border Grid.Column="2" Classes="card" Padding="12">
                                <ScrollViewer>
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section" Text="SELECTED CALL" />
                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Select a call to inspect its arguments and result."
                                                   IsVisible="{Binding SelectedEvent, Converter={x:Static ObjectConverters.IsNull}}" />
                                        <StackPanel Spacing="8" DataContext="{Binding SelectedEvent}" x:DataType="vm:EventRow"
                                                    IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Classes="mono strong" FontWeight="Medium" Text="{Binding Tool}" />
                                            <Border Classes="code">
                                                <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap" Text="{Binding Detail}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- tools -->
                <TabItem Header="Tools">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">
                        <Border Grid.Row="0" Classes="card" Padding="12,8" Margin="0,0,0,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Classes="pill" Classes.ok="{Binding SavedGood}" Classes.warn="{Binding SavedSome}"><TextBlock Classes="num" Text="{Binding SavedText}" /></Border>
                                <TextBlock Classes="mono secondary num" VerticalAlignment="Center" Text="{Binding ContextMeter}" />
                            </DockPanel>
                        </Border>
                        <TextBox Grid.Row="1" Text="{Binding ToolFilter}" PlaceholderText="Filter tools by name or description" Margin="0,0,0,8" />
                        <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
                            <ScrollViewer>
                                <ItemsControl Classes="rows" ItemsSource="{Binding FilteredTools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolRow">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="mono strong" FontWeight="Medium" Text="{Binding Name}" VerticalAlignment="Center" />
                                                            <Border Classes="pill" IsVisible="{Binding IsBridged}"><TextBlock Text="{Binding Bridge}" /></Border>
                                                            <Border Classes="pill" IsVisible="{Binding HasDecision}" Classes.ok="{Binding DecisionAlways}" Classes.danger="{Binding DecisionNever}" ToolTip.Tip="Remembered Safe-mode decision for this session"><TextBlock Text="{Binding Decision}" /></Border>
                                                        </StackPanel>
                                                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Classes="mono muted num" Text="{Binding TokensText}" MinWidth="60" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Classes="pill" MinWidth="78" Classes.ok="{Binding IsReadOnly}" Classes.warn="{Binding IsMutating}" Classes.danger="{Binding IsDestructive}">
                                                        <TextBlock Text="{Binding Risk}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="3" Classes="pill" MinWidth="76" Classes.indigo="{Binding StateIndigo}">
                                                        <TextBlock Text="{Binding VisibilityText}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <Panel Grid.Column="4" VerticalAlignment="Center" MinWidth="64">
                                                        <Button Command="{Binding RevealCommand}" Content="Unlock" IsVisible="{Binding CanUnlock}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                                        <Button Command="{Binding LockCommand}" Content="Lock" IsVisible="{Binding CanLock}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Hide this tool from tools/list again to free context" />
                                                    </Panel>
                                                    <Button Grid.Column="5" Classes="ghost" Command="{Binding ForgetCommand}" Content="Forget" IsVisible="{Binding HasDecision}" VerticalAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Drop the remembered decision; this tool will be held for approval again" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        </Panel>

        <!-- ============================================================ configurator -->
        <Panel Grid.Column="1" IsVisible="{Binding ShowConfig}">
        <ScrollViewer DataContext="{Binding Config}" x:DataType="vm:ConfigViewModel" Padding="20,14,20,16">
            <StackPanel Spacing="12" MaxWidth="880" HorizontalAlignment="Left">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h1" Text="Configurator &amp; launcher" />
                    <TextBlock Classes="secondary" FontSize="12" Text="Build the server command line, register it in your MCP clients, or start a local test instance." />
                </StackPanel>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="title" Text="Server binary" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseServerCommand}" Content="Browse" Margin="8,0,0,0" />
                            <TextBox Classes="mono" Text="{Binding ServerPath}" PlaceholderText="/path/to/Hubris" />
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="#F87171" IsVisible="{Binding !ServerPathValid}" Text="Not found. Point this at the published Hubris executable." />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="title" Text="Policy" />
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <Border Classes="seg">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="seg" Classes.on="{Binding IsSafe}" Command="{Binding SetSafeCommand}" Content="Safe" />
                                    <Button Classes="seg" Classes.on="{Binding IsBypass}" Command="{Binding SetBypassCommand}" Content="Bypass" />
                                </StackPanel>
                            </Border>
                            <CheckBox IsChecked="{Binding Compact}" Content="Compact context (hide on-demand tools until unlocked)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <CheckBox IsChecked="{Binding Verbose}" Content="Verbose stderr logging" />
                            <CheckBox IsChecked="{Binding NoControl}" Content="Disable control socket (no dashboard, no approvals)" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="Approval timeout (s)" />
                                <TextBox Classes="mono" Text="{Binding ApprovalTimeout}" Width="64" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding AddBridgeCommand}" Content="Add bridge" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="title" Text="External MCP servers (bridges)" />
                                <TextBlock Classes="muted" FontSize="11" Text="Each bridge runs as a child process; its tools appear as name__tool. Risk is read from the tool annotations." />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Bridges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BridgeRow">
                                    <Grid ColumnDefinitions="130,190,*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                        <TextBox Grid.Column="0" Text="{Binding Name}" PlaceholderText="name (gh)" />
                                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding Command}" PlaceholderText="command (npx)" />
                                        <TextBox Grid.Column="2" Classes="mono" Text="{Binding Args}" PlaceholderText="arguments (-y @modelcontextprotocol/server-github)" />
                                        <Button Grid.Column="3" Classes="ghost" Command="{Binding RemoveCommand}" Content="Remove" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CopyCommandCommand}" Content="Copy" />
                            <TextBlock Classes="title" VerticalAlignment="Center" Text="Resulting command" />
                        </DockPanel>
                        <Border Classes="code">
                            <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding CommandPreview}" />
                        </Border>
                        <TextBlock Classes="muted" FontSize="11" Text="For Claude Code:  claude mcp add hubris -- &lt;command above&gt;" />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="card" Padding="14,12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="title" Text="Claude Desktop" />
                            <TextBlock Classes="mono muted" FontSize="11" TextWrapping="Wrap" Text="{Binding ClaudeConfigPath}" />
                            <Button Command="{Binding InstallClaudeCommand}" HorizontalAlignment="Left">
                                <TextBlock Text="Write claude_desktop_config.json" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Padding="14,12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="title" Text="VS Code workspace" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding BrowseWorkspaceCommand}" Content="Choose" Margin="8,0,0,0" />
                                <TextBox Classes="mono" Text="{Binding WorkspaceFolder}" PlaceholderText="workspace folder" />
                            </DockPanel>
                            <TextBlock Classes="mono muted" FontSize="11" TextWrapping="Wrap" Text="{Binding VsCodeConfigPath}" />
                            <Button Command="{Binding InstallVsCodeCommand}" HorizontalAlignment="Left">
                                <TextBlock Text="Write .vscode/mcp.json" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="card" Padding="14,12">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding LaunchTestCommand}" Content="Launch test instance" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="title" Text="Test instance" />
                                <TextBlock Classes="muted" FontSize="11" Text="Starts the server with these flags, keeps it alive and shows it in the sidebar so you can try approvals." />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding LastResult}" TextWrapping="Wrap" IsVisible="{Binding LastResult.Length}" />
                        <Border Classes="hair" Margin="0,2" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding ClearLogCommand}" Padding="6,1" MinHeight="20" FontSize="11" Content="Clear" />
                            <TextBlock Classes="section" VerticalAlignment="Center" Text="LAUNCHER LOG" />
                        </DockPanel>
                        <Border Classes="code" MinHeight="96">
                            <ScrollViewer MaxHeight="220">
                                <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap" Text="{Binding LogText}" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Panel>
    </Grid>
</Window>
