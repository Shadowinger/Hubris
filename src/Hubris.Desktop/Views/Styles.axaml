<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinWidth" Value="130" />
    </Style>
    <Style Selector="Border.tile TextBlock.label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.tile TextBlock.value">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Menlo, Consolas, 'DejaVu Sans Mono', monospace" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="Menlo, Consolas, 'DejaVu Sans Mono', monospace" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.approval">
        <Setter Property="Background" Value="#22BC8CFF" />
        <Setter Property="BorderBrush" Value="#BC8CFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Button.approve">
        <Setter Property="Background" Value="#3FB950" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.deny">
        <Setter Property="Background" Value="#F85149" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</Styles>
